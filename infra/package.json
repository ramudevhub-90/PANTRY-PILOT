    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.1151.0",
    "@aws-sdk/client-sts": "^3.1151.0",
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1145.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
